<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in the shell is worth backing up. The WebView's storage holds sign-in tokens and
     wallet authorizations, which must not travel to a cloud backup. The manifest already sets
     allowBackup="false"; these rules say the same explicitly for devices below API 31. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
