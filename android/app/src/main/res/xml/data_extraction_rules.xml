<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in the shell is worth backing up or transferring. The WebView's storage holds
     sign-in tokens and wallet authorizations, which must not travel to a cloud backup or to
     another device. The manifest already sets allowBackup="false"; these rules say the same
     explicitly for API 31 and newer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
