{
  "name": "allowance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:rehearsal": "tsx scripts/build-rehearsal.ts",
    "brand:generate": "tsx scripts/generate-brand-kit.ts",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:operator": "tsx scripts/setup-operator.ts",
    "preflight": "node dist/server/preflight.js",
    "db:maintenance": "tsx server/db/maintenance.ts",
    "test:container": "node scripts/verify-container.mjs",
    "smoke:devnet": "tsx scripts/smoke-devnet.ts",
    "smoke:mainnet": "tsx scripts/smoke-mainnet.ts",
    "mcp": "tsx server/mcp.ts",
    "test:browser": "playwright test",
    "test:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
