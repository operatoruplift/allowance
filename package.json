    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "fontkit": "2.0.4",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
