    "@x402/extensions": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/svm": "2.25.0",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "lossless-json": "4.3.1",
    "lucide-react": "1.45.0",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
