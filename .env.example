# Copy to .env, then npm run setup:operator. No secrets are needed for /demo.
PORT=4318
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4318
DATABASE_PATH=var/allowance.sqlite
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
# Behind a single trusted HTTPS reverse proxy in hosted mode: PROXY_HOPS=1
PROXY_HOPS=0

# Mainnet is the product default. Payments remain OFF until explicitly configured.
# Use a dedicated low-balance payer; never use your main wallet secret.
LIVE_PAYMENTS_ENABLED=false
PAYMENT_NETWORK=mainnet
MAINNET_PAYMENTS_ACKNOWLEDGED=false
PAYER_SECRET_FILE=secrets/mainnet-payer.json
# Alternative: ignored server environment only; never VITE_ variables.
PAYER_SECRET_JSON=
MERCHANT_RECIPIENT=
PAYMENT_RPC_URL=https://api.mainnet-beta.solana.com
# Choose a production facilitator that advertises v2 exact Solana mainnet.
FACILITATOR_URL=
FACILITATOR_TOKEN=
# Pin after reviewing /supported; see docs/live-setup.md. No automatic trust.
TRUSTED_FEE_PAYER=
DAILY_USDC_CEILING=0.100000
MAX_RUN_ALLOWANCE=0.040000

DATA_NETWORK=mainnet
DATA_RPC_URL=https://api.mainnet-beta.solana.com
ALLOW_MAINNET_READ_ONLY=true
DEMO_WALLET=

# Official Responses API. This model is documented at developers.openai.com/api/docs/models/gpt-5-mini.
# Set a model explicitly; no guessed fallback is used by the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_MAX_CALLS=5
LLM_MAX_OUTPUT_TOKENS=1200

# Local external-agent bridge (stdio only; disabled by default).
# Create a scoped grant through the authenticated operator API before starting MCP.
MCP_ENABLED=false
MCP_GRANT_TOKEN=

# Guarded direct payments (mandates). Disabled by default. An agent may pay exact USDC
# to recipients the operator listed when authorizing the mandate; every request is
# checked against the frozen caps, the allowlist, the shared daily ceiling and the
# payer hold before the dedicated payer signs and submits the transfer itself.
# Requires explicit PAYMENT_NETWORK and PAYMENT_RPC_URL and the same PAYER_SECRET_* source.
# Start on devnet: PAYMENT_NETWORK=devnet, PAYMENT_RPC_URL=https://api.devnet.solana.com,
# a payer funded with devnet SOL and devnet USDC (mint 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU).
DIRECT_PAYMENTS_ENABLED=false
# Solana address whose plain Ed25519 message signature may add a recipient to an active mandate.
# Leave empty to freeze each mandate's recipients at authorization time.
ADMIN_PUBLIC_KEY=
# Optional bounds: priority fee per compute unit, the SOL fee cap per transfer, and the SOL
# bound for creating a recipient's USDC token account when it does not exist yet.
DIRECT_PRIORITY_FEE_MICROLAMPORTS=0
DIRECT_MAX_FEE_LAMPORTS=15000
DIRECT_MAX_ACCOUNT_CREATION_LAMPORTS=3000000
