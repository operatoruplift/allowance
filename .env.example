# Copy to .env, then npm run setup:operator. No secrets are needed for /demo.
PORT=4318
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4318
DATABASE_PATH=var/allowance.sqlite
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
# Behind a single trusted HTTPS reverse proxy in hosted mode: PROXY_HOPS=1
PROXY_HOPS=0

# Explicit devnet opt-in. Never use a main-wallet secret.
LIVE_PAYMENTS_ENABLED=false
PAYMENT_NETWORK=devnet
PAYER_SECRET_FILE=secrets/devnet-payer.json
# Alternative: ignored server environment only; never VITE_ variables.
PAYER_SECRET_JSON=
MERCHANT_RECIPIENT=
PAYMENT_RPC_URL=https://api.devnet.solana.com
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_TOKEN=
# Pin after reviewing /supported; see docs/live-setup.md. No automatic trust.
TRUSTED_FEE_PAYER=
DAILY_USDC_CEILING=0.100000
MAX_RUN_ALLOWANCE=0.040000

DATA_NETWORK=devnet
DATA_RPC_URL=https://api.devnet.solana.com
ALLOW_MAINNET_READ_ONLY=false
DEMO_WALLET=

# Official Responses API. This model is documented at developers.openai.com/api/docs/models/gpt-5-mini.
# Set a model explicitly; no guessed fallback is used by the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_MAX_CALLS=5
LLM_MAX_OUTPUT_TOKENS=1200
